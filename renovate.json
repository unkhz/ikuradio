{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "prConcurrentLimit": 0,
  "reviewers": ["unkhz"],
  "packageRules": [
    {
      "groupName": "oven/bun",
      "matchManagers": ["npm", "bun"],
      "matchPackageNames": ["@types/bun"],
      "enabled": true
    },
    {
      "groupName": "oven/bun",
      "matchManagers": ["bun-version"],
      "matchFileNames": [".bun-version"],
      "enabled": true
    },
    {
      "groupName": "oven/bun",
      "matchManagers": ["npm", "bun"],
      "matchFileNames": ["package.json", "bun.lock"],
      "matchPackageNames": ["oven/bun", "@types/bun"],
      "enabled": true
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "matchCurrentVersion": "!/^0/",
      "platformAutomerge": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "The Music's Python is the one PyTorch publishes CUDA wheels for; move it by hand, with torch.",
      "matchFileNames": ["packages/music/pyproject.toml"],
      "matchDepNames": ["python"],
      "enabled": false
    }
  ]
}
