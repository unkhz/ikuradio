diff --git a/crates/chimera/src/phonetics/notes.rs b/crates/chimera/src/phonetics/notes.rs
new file mode 100644
index 0000000..5bc57b0
--- /dev/null
+++ b/crates/chimera/src/phonetics/notes.rs
@@ -0,0 +1,100 @@
+//! A melody with lyrics, sung offline: what `chimera render notes` sings, as a library, so that
+//! the CLI and the browser sing the same score the same way, sample for sample.
+//!
+//! The score is JSON: `{"bpm", "lyrics", "notes": [[midi, beats], …]}`, a midi of 0 or less
+//! being a rest, with optional `t0` (seconds before the first beat), `vibrato` (cents) and the
+//! singer's throat: `pressure` (cmH2O), `tension` and `breathiness`.
+
+use crate::anatomy::human::{BODY_CHILD, BODY_FEMALE, BODY_MALE, HumanBody};
+use crate::math::{js_max, js_round};
+use crate::phonetics::english::EnglishG2P;
+use crate::phonetics::sing::{SongOptions, SungNote, midi_to_hz, plan_song};
+use crate::phonetics::syllables::lyrics_to_syllables;
+use crate::voice::human_voice::{HumanVoice, SourcePatch};
+
+/// A body by its name: male, female or child.
+pub fn body_named(name: &str) -> Result<HumanBody, String> {
+    match name {
+        "male" => Ok(BODY_MALE),
+        "female" => Ok(BODY_FEMALE),
+        "child" => Ok(BODY_CHILD),
+        _ => Err(format!("unknown body {name:?}; have male, female, child")),
+    }
+}
+
+/// A voice with a whole score scheduled on it, ready to be rendered.
+pub struct ScheduledNotes {
+    pub voice: HumanVoice,
+    /// how many samples the rendering lasts, the last note's release included
+    pub samples: usize,
+    /// how many notes are sung (not rests)
+    pub sounding: usize,
+}
+
+/// Schedules a score on a new voice of `body_name` at `fs`. Refuses a score whose lyrics do not
+/// have one syllable for every sung note, saying how many it heard.
+pub fn schedule_notes(j: &serde_json::Value, body_name: &str, g: &EnglishG2P, fs: f64) -> Result<ScheduledNotes, String> {
+    let b = body_named(body_name)?;
+    let bpm = j["bpm"].as_f64().ok_or("bpm missing")?;
+    let vibrato = j["vibrato"].as_f64().unwrap_or(35.0);
+    let raw: Vec<[f64; 2]> = serde_json::from_value(j["notes"].clone()).map_err(|e| format!("notes: {e}"))?;
+    let syl = lyrics_to_syllables(j["lyrics"].as_str().ok_or("lyrics missing")?, g);
+    let sounding = raw.iter().filter(|n| n[0] > 0.0).count();
+    if syl.len() != sounding {
+        return Err(format!("{} syllables for {sounding} notes: {}", syl.len(),
+            syl.iter().map(|s| s.text.as_str()).collect::<Vec<_>>().join(" ")));
+    }
+    let t0 = j["t0"].as_f64().unwrap_or(0.3);
+    // the song's own: how hard each singer breathes, and how tightly their folds close
+    let pressure = j["pressure"].as_f64().unwrap_or(9.0);
+    let tension = j["tension"].as_f64().unwrap_or(0.55);
+    let breathiness = j["breathiness"].as_f64();
+    let beat = 60.0 / bpm;
+    let mut v = HumanVoice::new(fs, b, 2);
+    let first = raw.iter().find(|n| n[0] > 0.0).ok_or("no notes")?;
+    v.set_source(&SourcePatch {
+        f0: Some(midi_to_hz(first[0])),
+        voiced: Some(true),
+        pressure: Some(pressure),
+        tension: Some(tension),
+        breathiness,
+        ..Default::default()
+    });
+    let (mut t, mut k, mut end) = (t0, 0usize, 0.0f64);
+    let mut phrase: Vec<SungNote> = Vec::new();
+    let mut start = t;
+    let flush = |phrase: &mut Vec<SungNote>, start: f64, v: &mut HumanVoice, end: &mut f64| {
+        if phrase.is_empty() {
+            return;
+        }
+        let plan = plan_song(phrase, &SongOptions { body: body_name.into(), bpm, t0: start, vibrato });
+        v.schedule(&plan.gestures);
+        *end = js_max(*end, plan.end);
+        phrase.clear();
+    };
+    for n in &raw {
+        if n[0] > 0.0 {
+            if phrase.is_empty() {
+                start = t;
+            }
+            phrase.push(SungNote { midi: n[0], beats: n[1], syl: syl[k].clone() });
+            k += 1;
+        } else {
+            flush(&mut phrase, start, &mut v, &mut end);
+        }
+        t += n[1] * beat;
+    }
+    flush(&mut phrase, start, &mut v, &mut end);
+    let samples = js_round(fs * (end + 0.4)) as usize;
+    Ok(ScheduledNotes { voice: v, samples, sounding })
+}
+
+/// Sings a score whole, in blocks of 128 samples, as the CLI renders it.
+pub fn render_notes(j: &serde_json::Value, body_name: &str, g: &EnglishG2P, fs: f64) -> Result<Vec<f32>, String> {
+    let mut s = schedule_notes(j, body_name, g, fs)?;
+    let mut out = vec![0f32; s.samples];
+    for block in out.chunks_mut(128) {
+        s.voice.render(block);
+    }
+    Ok(out)
+}
