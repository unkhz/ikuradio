@@ -0,0 +1,83 @@
+//! English text said offline, as `chimera render text` says it, as a library: the CMU dictionary,
+//! the phrase planner, a body and its speaking pitch. What the CLI and the browser say is the same
+//! speech, sample for sample. The request is JSON: `{"text", "body", "sampleRate"}`, a body being a name or a mix, `{"female", "child"}`,, and, to
+//! shape the voice, `rate` (a speaking-rate multiplier, 1 as usual), `stretch` (`[[word, factor], …]`, words drawn out), `f0` (the baseline pitch in
+//! Hz), `accent` (how far stressed syllables lean, a fraction), and the throat: `pressure`
+//! (cmH2O), `tension` and `breathiness`.
+
+use crate::phonetics::english::EnglishG2P;
+use crate::anatomy::human::{BodyMix, BodyName};
+use crate::phonetics::planner::{PhraseInput, PlanOptions, plan_phrases};
+use crate::phonetics::Plan;
+use crate::voice::human_voice::{HumanVoice, SourcePatch};
+use crate::math::js_round;
+
+/// What a body speaks at, as `render text` does, blended as the body is.
+pub fn speaking_f0(body: BodyMix) -> f64 {
+    body.blend(|b| match b {
+        BodyName::Female => 205.0,
+        BodyName::Child => 250.0,
+        BodyName::Male => 112.0,
+    })
+}
+
+/// Speech, as samples, with the plan it was said from: its segments and when each is said.
+pub struct Said {
+    pub samples: Vec<f32>,
+    pub plan: Plan,
+}
+
+/// Says `j["text"]` in a new voice of the body `j["body"]` at `fs`.
+pub fn say(j: &serde_json::Value, g: &EnglishG2P, fs: f64) -> Result<Said, String> {
+    // a body is a name, male, female or child, or a mix of them: {"female": 0..1, "child": 0..1}
+    let mix: BodyMix = serde_json::from_value(j["body"].clone()).map_err(|e| format!("body: {e}"))?;
+    let text = j["text"].as_str().ok_or("text missing")?;
+    let f0 = j["f0"].as_f64().unwrap_or_else(|| speaking_f0(mix));
+    let mut voice = HumanVoice::new(fs, mix.body(), 2);
+    voice.set_source(&SourcePatch {
+        f0: Some(f0),
+        pressure: j["pressure"].as_f64(),
+        tension: j["tension"].as_f64(),
+        breathiness: j["breathiness"].as_f64(),
+        ..Default::default()
+    });
+    let mut phrases = g.to_phrases(text);
+    // `stretch`: [[word, factor], ...], the words said counted from 0 across the phrases. A word
+    // drawn out, for effect, has its vowels held as many times as long as the planner would
+    if let Some(list) = j["stretch"].as_array() {
+        let factors: std::collections::HashMap<usize, f64> =
+            list.iter().filter_map(|pair| Some((pair[0].as_u64()? as usize, pair[1].as_f64()?))).collect();
+        let mut word = 0usize;
+        for phrase in phrases.iter_mut() {
+            for seg in phrase.segments.iter_mut() {
+                if let (Some(f), Some(stress)) = (factors.get(&word), seg.stress) {
+                    seg.dur = Some(match stress { 1 => 0.17, 2 => 0.13, _ => 0.095 } * f);
+                }
+                if seg.word_end == Some(true) {
+                    word += 1;
+                }
+            }
+        }
+    }
+    let inputs: Vec<PhraseInput> = phrases
+        .iter()
+        .map(|p| PhraseInput { segments: p.segments.clone(), intonation: Some(p.intonation), pause: Some(p.pause) })
+        .collect();
+    let plan = plan_phrases(
+        &inputs,
+        &PlanOptions {
+            body: mix,
+            t0: 0.05,
+            f0: Some(f0),
+            rate: j["rate"].as_f64(),
+            accent: j["accent"].as_f64(),
+            ..Default::default()
+        },
+    );
+    voice.schedule(&plan.gestures);
+    let mut samples = vec![0f32; js_round(fs * (plan.end + 0.3)) as usize];
+    for block in samples.chunks_mut(128) {
+        voice.render(block);
+    }
+    Ok(Said { samples, plan })
+}
