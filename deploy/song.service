# The song, living on its machine as a user service.
#
#   cp deploy/song*.service deploy/song-pulse.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now song.service song-pulse.timer
#   sudo loginctl enable-linger $USER    # to sing with nobody logged in
#
# On air: the Archive's door, the Radio, and a Studio called in when needed.
# Stopped, the Radio remembers its Tactus and the Studio its diary.

[Unit]
Description=The song that never ends
After=network-online.target

[Service]
WorkingDirectory=%h/Work/song
ExecStart=/usr/bin/bun run on-air
# the Music's model is already on the shelf; nothing needs to be fetched
Environment=HF_HUB_OFFLINE=1
Nice=5
Restart=on-failure
RestartSec=30
TimeoutStopSec=15

[Install]
WantedBy=default.target
