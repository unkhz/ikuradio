{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "paths": {
      "tools": ["packages/tools"],
      "melody": ["packages/melody"],
      "mood": ["packages/mood"],
      "vocals": ["packages/vocals"],
      "song": ["packages/song"],
      "song/*": ["packages/song/*"]
    }
  }
}
